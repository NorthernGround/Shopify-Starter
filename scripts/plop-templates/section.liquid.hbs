{{#if isBundled}}
{% liquid
  assign stylesheet_url = '{{name}}.css' | asset_url
%}
<link rel='stylesheet' href='{% echo stylesheet_url %}'>
{{/if}}
{{#if hasJavaScript}}<theme-{{name}}{{else}}<section{{/if}}
  class='{{name}}'
  {% echo section.shopify_attributes %}
>
  <div class='{{name}}__inner page-width'>
    {% if section.settings.heading != blank %}
      <h2 class='{{name}}__heading'>{% echo section.settings.heading %}</h2>
    {% endif %}
  </div>
{{#if hasJavaScript}}</theme-{{name}}>{{else}}</section>{{/if}}

{% schema %}
{
  "name": "{{titleCase name}}",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ],
  "presets": [
    {
      "name": "{{titleCase name}}"
    }
  ]
}
{% endschema %}